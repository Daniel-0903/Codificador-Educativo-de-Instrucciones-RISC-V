              "lw", "lb", "sw", "sb", "beq", "bne"]

INSTRUCTIONS = {
    "add": {
        "format": "R",
        "opcode": 0b0110011,
        "funct3": 0b000,
        "funct7": 0b0000000,
    },
    "sub": {
